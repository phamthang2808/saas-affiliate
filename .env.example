# ==============================================================================
# CẤU HÌNH BIẾN MÔI TRƯỜNG CHO WEBSITE TRƯỞNG NHÓM (FRONTEND .ENV)
# ==============================================================================

# 1. Địa chỉ Backend API (Spring Boot Commercial - Port 8081)
VITE_API_URL=http://localhost:8081

# 2. Cấu hình Định danh Trưởng Nhóm (Nếu điền, website sẽ tự động ghim cho nhóm này)
# Để trống nếu muốn chạy ở chế độ Đa Nhóm (SaaS Platform)
VITE_TENANT_ID=1
VITE_TENANT_SLUG=tranhuyen
VITE_TENANT_NAME=Trần Huyền Affiliate
VITE_BRAND_TITLE=Trần Huyền — Hệ Thống Tra Cứu & Hoàn Tiền Shopee/TikTok

# 3. Thông tin liên hệ & CSKH của Trưởng Nhóm
VITE_TENANT_CONTACT_ZALO=0988123456
VITE_TENANT_PRIMARY_COLOR=#f97316

# 4. Tỷ lệ phân chia hoa hồng (%)
# Khách nhận: 80% | Thuế TNCN: 10% | Phí nền tảng: 10%
VITE_TENANT_CUSTOMER_SPLIT_RATE=80
VITE_TENANT_TAX_RATE=10
VITE_TENANT_PLATFORM_FEE_RATE=10
